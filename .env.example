# Copy to .env and edit. Used by docker-compose (and any process that exports
# these). All values override config/agents_settings.ini at runtime.

# Provider extras to install in the image (uv flags). Examples:
#   --extra openai      (OpenAI, vLLM, LM Studio, Azure)
#   --extra anthropic
#   --extra aws
# Leave empty for Ollama only.
SCALE_AGENTS_EXTRAS=

# --- LLM backend ---
# provider: ollama | openai | anthropic | azure | bedrock
SCALE_AGENTS_LLM_PROVIDER=ollama
SCALE_AGENTS_LLM_MODEL=qwen3:latest
# Ollama (bundled service): http://ollama:11434
# vLLM / OpenAI-compatible: http://your-host:8000/v1
SCALE_AGENTS_LLM_BASE_URL=http://ollama:11434
# API key for openai/anthropic/azure (leave blank for Ollama / local vLLM).
SCALE_AGENTS_LLM_API_KEY=
# Only for provider=azure:
# SCALE_AGENTS_LLM_AZURE_API_VERSION=2024-06-01
# Only for provider=bedrock (else uses AWS_REGION / default chain):
# SCALE_AGENTS_LLM_AWS_REGION=us-east-1

# --- MCP server (external IBM Storage Scale MCP server) ---
# If it runs on the Docker host, use host.docker.internal:
SCALE_AGENTS_MCP_URL=http://host.docker.internal:8000/mcp
